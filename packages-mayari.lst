# Mayari package list (Void xbps package names, one per line, '#' = comment)
# Fed to mklive.sh via -p "$(grep -v '^#' packages-mayari.lst | tr '\n' ' ')"
#
# Organized to mirror Kali's own tool categories (MITRE-ATT&CK-ish phases).
# Only lists tools that genuinely have a Void package. A LOT of Kali's
# catalog is Debian-only (BloodHound CE, Burp, GVM/OpenVAS, Empire, SET,
# Armitage, Gophish, Mimikatz, etc.) -- those are handled instead by
# mayari-extra-tools.sh via go install / pip / gem / upstream release.
#
# Verify names before a build: xbps-query -Rs <name>   (names drift over time)
# install_group() in build-mayari-iso.sh / mayari-postinstall.sh already
# skips anything not found, so a stale name here just gets a warning.

# --- Base desktop (XFCE, matches Kali/Parrot's default DE footprint) ---
xfce4
xfce4-terminal
xfce4-goodies
lightdm
lightdm-gtk3-greeter
network-manager-applet
NetworkManager
